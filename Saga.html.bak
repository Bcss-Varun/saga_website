          <div id="worldslot" aria-hidden="true"><span class="wlabel" id="wlabel">Angular · grid</span></div>
          <div id="wapp"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 CAPABILITIES -->
  <section class="sec" id="caps" data-scene="orbit">
    <div class="inner">
      <p class="eyebrow rv">Capabilities</p>
      <h2 class="rv d1" style="max-width:18ch">Start with the question you actually have.</h2>
      <p class="rv d2">Every capability group answers one question a real operator asks. Open one to see what sits
        underneath it.</p>
      <div class="caps" id="capgrid"></div>
    </div>
  </section>

  <!-- 08 FLOW -->
  <section class="sec" id="flow">
    <div class="inner">
      <p class="eyebrow rv">Signal to action</p>
      <h2 class="rv d1" style="max-width:17ch">Every signal has somewhere to go.</h2>
      <div class="flow">
        <div class="fstep rv"><span class="n">01</span>
          <h3>Detected</h3>
          <p>A post, article or event enters the stream and is classified in seconds.</p>
        </div>
        <div class="fstep rv d1"><span class="n">02</span>
          <h3>Scored</h3>
          <p>Sentiment, topic and risk are attached. Viral potential is estimated.</p>
        </div>
        <div class="fstep rv d2"><span class="n">03</span>
          <h3>Verified</h3>
          <p>Source attribution, identity resolution and deepfake checks where it matters.</p>
        </div>
        <div class="fstep rv d3"><span class="n">04</span>
          <h3>Escalated</h3>
          <p>An alert opens a case, routed to whoever owns that geography or subject.</p>
        </div>
        <div class="fstep rv d3"><span class="n">05</span>
          <h3>Resolved</h3>
          <p>Action taken, outcome recorded, evidence retained, report generated.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 ROUTES -->
  <section class="sec">
    <div class="inner">
      <p class="eyebrow rv">Explore your SAGA</p>
      <h2 class="rv d1" style="max-width:14ch">Which one of these is you?</h2>
      <div class="routes">
        <a class="route rv" href="#worlds" data-go="police"><span class="k">I work in</span>
          <h3>Law enforcement</h3>
          <p>Threat detection, persons of interest, investigation and evidence.</p><span class="go">Police Saga →</span>
        </a>
        <a class="route rv d1" href="#worlds" data-go="political"><span class="k">I work in</span>
          <h3>Political operations</h3>
          <p>Constituency sentiment, grievances, early warning on unrest.</p><span class="go">Political Saga →</span>
        </a>
        <a class="route rv d2" href="#worlds" data-go="brand"><span class="k">I work in</span>
          <h3>Brand &amp; comms</h3>
          <p>Reputation monitoring, crisis detection, source attribution.</p><span class="go">Brand Saga →</span>
        </a>
        <a class="route rv d3" href="#worlds" data-go="celebrity"><span class="k">I work in</span>
          <h3>Talent management</h3>
          <p>Fan sentiment, coordinated attacks, endorsement intelligence.</p><span class="go">Celebrity Saga →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 10 FINAL -->
  <section class="sec" id="final">
    <div class="inner">
      <p class="eyebrow rv">Request a demonstration</p>
      <h2 class="rv d1" style="max-width:17ch;margin-left:auto;margin-right:auto">See it running on your own region.
      </h2>
      <p class="lead rv d2" style="max-width:48ch">Tell us which world you operate in and we will show you SAGA
        configured for it — not a generic deck.</p>
      <div class="finalrow rv d3">
        <a class="cta" href="mailto:smartapps@bluecloudsoftech.com?subject=SAGA%20demo%20request">Request a Demo</a>
        <a class="cta2" href="#worlds">Explore a product</a>
