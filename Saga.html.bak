<title>SAGA Homepage Mockup</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap">

<style>
  :root {
    --black: #000;
    --s1: #08080A;
    --s2: #0E0E11;
    --s3: #16161A;
    --orange: #F15B26;
    --lift: #FF7A45;
    --soft: #FF9A6B;
    --deep: #C4441A;
    --ember: #7A2A0E;
    --ink: #F5F5F4;
    --strong: #fff;
    --muted: #A5A09B;
    --faint: #8A857F;
    --line: rgba(255, 255, 255, .08);
    --line2: rgba(255, 255, 255, .14);
    --lineo: rgba(241, 91, 38, .32);
    --glass: rgba(255, 255, 255, .025);
    --glasso: rgba(241, 91, 38, .055);
    --ok: #5FD08A;
    --warn: #F5A524;
    --crit: #FF4D1F;
    --fd: 'Outfit', system-ui, sans-serif;
    --fb: 'Outfit', system-ui, sans-serif;
    --fm: 'Outfit', system-ui, sans-serif;
    --ease: cubic-bezier(.16, 1, .3, 1);
    --frame: #EEEEF5;
  }

  * {
    box-sizing: border-box
  }

  html {
    scroll-behavior: smooth
  }

  body {
    margin: 0;
    background: var(--black);
    color: var(--ink);
    font-family: var(--fb);
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden
  }

  ::selection {
    background: var(--orange);
    color: #000
  }

  :focus-visible {
    outline: 2px solid var(--lift);
    outline-offset: 3px;
    border-radius: 4px
  }

  img,
  svg {
    display: block;
    max-width: 100%
  }

  /* ── persistent canvas ─────────────────────────── */
  #stage {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none
  }

  .wrap {
    position: relative;
    z-index: 1
  }

  /* ── hero frame backdrops; both position/size synced to #hero in JS.
   heroLightBg = the light gutter, sized to hero's outer (margin) box.
   heroFrameBg = the black card, sized to hero's own box, painted on top of the light layer. ── */
  #heroLightBg {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    z-index: -2;
    background: var(--frame);
    opacity: 0;
    transition: opacity .25s var(--ease);
    pointer-events: none
  }

  #heroLightBg.show {
    opacity: 1
  }

  #heroFrameBg {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    z-index: -1;
    background: var(--black);
    box-shadow: 0 30px 80px rgba(0, 0, 0, .14);
    opacity: 0;
    transition: opacity .25s var(--ease);
    pointer-events: none
  }

  #heroFrameBg.show {
    opacity: 1
  }

  /* ── nav ───────────────────────────────────────── */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    margin: 0 auto;
    width: 100%;
    max-width: 1600px;
    z-index: 50;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(18px, 3vw, 44px);
    background: transparent;
    border: 1px solid transparent;
    will-change: transform, max-width, top, height;
    transition: transform .5s cubic-bezier(.22, 1, .36, 1), top .5s cubic-bezier(.22, 1, .36, 1), max-width .5s cubic-bezier(.22, 1, .36, 1), height .5s cubic-bezier(.22, 1, .36, 1), padding .5s cubic-bezier(.22, 1, .36, 1)
  }

  nav.floating {
    top: 20px;
    max-width: 1080px;
    height: 64px
  }

  nav.hidden {
    transform: translateY(-150%)
  }

  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    position: relative
  }

  .brand-logo {
    height: 52px;
    width: auto;
    transition: height .5s cubic-bezier(.22, 1, .36, 1), transform .2s var(--ease), opacity .4s var(--ease)
  }

  .brand-logo:hover {
    transform: scale(1.02)
  }

  nav.floating .brand-logo {
    height: 42px
  }

  .brand-logo.logo-dark {
    border-radius: 10px;
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0;
    pointer-events: none
  }

  nav.floating .brand-logo.logo-dark {
    border-radius: 8px
  }

  nav.floating .brand-logo.logo-light {
    opacity: 0
  }

  nav.floating .brand-logo.logo-dark {
    opacity: 1;
    pointer-events: auto
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 100%;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: background .5s cubic-bezier(.22, 1, .36, 1), border-color .5s cubic-bezier(.22, 1, .36, 1), padding .5s cubic-bezier(.22, 1, .36, 1), box-shadow .5s cubic-bezier(.22, 1, .36, 1)
  }

  nav.floating .nav-menu {
    background: rgba(12, 12, 14, .85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-color: var(--line2);
    padding: 0 8px 0 24px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, .36)
  }

  .navlinks {
    display: flex;
    gap: 4px;
    align-items: center
  }

  .navlinks a {
    font-family: var(--fb);
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    padding: 8px 13px;
    border-radius: 8px;
    transition: .16s, color .4s var(--ease)
  }

  .navlinks a:hover {
    color: var(--ink);
    background: var(--glass)
  }

  nav:not(.floating) .navlinks a {
    color: #3D3D45
  }

  nav:not(.floating) .navlinks a:hover {
    color: #000;
    background: rgba(0, 0, 0, .05)
  }

  .cta {
    font-family: var(--fd);
    font-weight: 500;
    font-size: 14px;
    background: var(--orange);
    color: #f5f5f5;
    padding: 11px 22px;
    border-radius: 8px;
    text-decoration: none;
    transition: .18s var(--ease);
    white-space: nowrap;
    border: 0;
    cursor: pointer
  }

  .cta:hover {
    background: var(--lift);
    box-shadow: 0 0 20px rgba(241, 91, 38, .28);
    transform: translateY(-1px)
  }

  .cta2 {
    font-family: var(--fd);
    font-weight: 500;
    font-size: 14px;
    background: transparent;
    color: var(--ink);
    padding: 11px 22px;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid var(--line2);
    transition: .18s;
    display: inline-block
  }

  .cta2:hover {
    border-color: var(--lineo);
    background: var(--glasso)
  }

  @media(max-width:940px) {
    .navlinks a {
      display: none
    }
  }

  @media(max-width:560px) {
    nav {
      padding: 0 14px
    }

    nav.floating {
      top: 10px
    }

    nav.floating .nav-menu {
      padding: 0 6px 0 16px;
      height: 56px
    }

    .brand-logo {
      height: 38px
    }

    .brand-logo.logo-dark {
      border-radius: 8px
    }

    .nav-menu .cta {
      padding: 9px 14px;
      font-size: 13px
    }
  }

  /* ── layout ────────────────────────────────────── */
  .sec {
    position: relative;
    padding: 112px clamp(20px, 4vw, 44px)
  }

  .inner {
    max-width: 1240px;
    margin: 0 auto
  }

  .eyebrow {
    font-family: var(--fd);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--orange);
    margin: 0 0 16px
  }

  #hero .eyebrow {
    color: var(--strong);
    font-size: 16px
  }

  h1 {
    font-family: var(--fd);
    font-weight: 500;
    font-size: clamp(2.9rem, 7vw, 6rem);
    line-height: .98;
    letter-spacing: -.035em;
    margin: 0 0 26px;
    color: var(--orange);
    text-wrap: balance
  }

  h2 {
    font-family: var(--fd);
    font-weight: 500;
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -.028em;
    margin: 0 0 18px;
    color: var(--orange);
    text-wrap: balance
  }

  h3 {
    font-family: var(--fd);
    font-weight: 500;
    font-size: 1.2rem;
    line-height: 1.3;
    letter-spacing: -.015em;
    margin: 0 0 9px;
    color: var(--strong)
  }

  p {
    margin: 0 0 16px;
    max-width: 60ch;
    color: var(--muted)
  }

  .lead {
    font-size: 1.14rem;
    color: var(--ink)
  }

  .small {
    font-size: .87rem
  }

  .mono {
    font-family: var(--fm);
    font-variant-numeric: tabular-nums
  }

  /* ── hero ──────────────────────────────────────── */
  :root {
    --p: 0;
    --hero-top: 112px;
    --hero-side: 200px;
    --hero-bottom: 0px
  }

  #hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding-top: calc(56px + var(--p) * 64px);
    padding-bottom: 70px;
    margin: calc((1 - var(--p)) * var(--hero-top)) calc((1 - var(--p)) * var(--hero-side)) calc((1 - var(--p)) * var(--hero-bottom))
  }

  @media(max-width:900px) {
    :root {
      --hero-top: 96px;
      --hero-side: 20px;
      --hero-bottom: 0px
    }
  }

  @media(max-width:560px) {
    :root {
      --hero-top: 84px;
      --hero-side: 12px;
      --hero-bottom: 0px
    }
  }

  #hero .inner {
    display: flex;
    flex-direction: column;
    align-items: center
  }

  #hero .lead {
    margin-left: auto;
    margin-right: auto
  }

  #hero h1 span {
    display: block
  }

  .herorow {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    margin-top: 68px;
  }

  @keyframes sweep {
    0% {
      transform: scaleX(.2);
      transform-origin: left
    }

    50% {
      transform: scaleX(1);
      transform-origin: left
    }

    51% {
      transform-origin: right
    }

    100% {
      transform: scaleX(.2);
      transform-origin: right
    }
  }

  /* ── trust ─────────────────────────────────────── */
  .trust {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 36px clamp(20px, 4vw, 44px);
    background: var(--s1)
  }

  .trustgrid {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    gap: 22px;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    align-items: start
  }

  .trustgrid .lbl {
    font-family: var(--fm);
    font-size: 10px;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 8px
  }

  .trustgrid p {
    font-size: .87rem;
    margin: 0;
    color: var(--muted)
  }

  /* ── narrative (pinned) ────────────────────────── */
  .pin {
    height: 250vh;
    position: relative
  }

  .pin .sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    padding: 0 clamp(20px, 4vw, 44px)
  }

  .pin .sticky .inner {
    width: 100%
  }

  .pin .copy {
    max-width: 490px
  }

  .pin .copy p {
    max-width: 46ch
  }

  .stagechip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--fm);
    font-size: 10px;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--faint);
    border: 1px solid var(--line2);
    border-radius: 999px;
    padding: 5px 13px;
    margin-bottom: 20px
  }

  .stagechip b {
    color: var(--orange);
    font-weight: 400
  }

  .metricrow {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
    margin-top: 26px;
    padding-top: 22px;
    border-top: 1px solid var(--line)
  }

  .metricrow div {
    min-width: 96px
  }

  .metricrow .k {
    font-family: var(--fm);
    font-size: 9.5px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--faint);
    display: block;
    margin-bottom: 5px
  }

  .metricrow .v {
    font-family: var(--fm);
    font-size: 1.5rem;
    color: var(--strong);
    font-variant-numeric: tabular-nums;
    letter-spacing: -.02em
  }

  /* ── worlds ────────────────────────────────────── */
  .tabrail {
    display: inline-flex;
    background: var(--s2);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px;
    gap: 2px;
    position: relative;
    margin-bottom: 38px;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none
  }

  .tabrail::-webkit-scrollbar {
    display: none
  }

  .tabrail button {
    position: relative;
    z-index: 1;
    font-family: var(--fd);
    font-weight: 500;
    font-size: 14.5px;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 10px 22px;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: color .24s var(--ease)
  }

  .tabrail button[aria-selected="true"] {
    color: #000
  }

  .tabrail .ind {
    position: absolute;
    top: 4px;
    bottom: 4px;
    background: var(--orange);
    border-radius: 999px;
    transition: transform .5s var(--ease), width .5s var(--ease);
    z-index: 0;
    left: 0
  }

  .worldgrid {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    gap: 44px;
    align-items: start
  }

  @media(max-width:980px) {
    .worldgrid {
      grid-template-columns: 1fr;
      gap: 32px
    }
  }

  .worldcopy h2 {
    margin-bottom: 14px
  }

  #worldslot {
    position: relative;
    height: 250px;
    border: 1px solid var(--line);
    border-radius: 14px 14px 0 0;
    border-bottom: 0;
    background: linear-gradient(180deg, var(--s1), rgba(8, 8, 10, 0));
    overflow: hidden
  }

  #worldslot .wlabel {
    position: absolute;
    left: 15px;
    bottom: 13px;
    font-family: var(--fm);
    font-size: 9.5px;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--faint)
  }

  #worldslot::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 90% at 50% 40%, transparent 40%, rgba(0, 0, 0, .55) 100%)
  }

  #wapp .app {
    border-radius: 0 0 14px 14px
  }

  .chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 22px 0
  }

  .chips span {
    font-family: var(--fm);
    font-size: 10.5px;
    letter-spacing: .05em;
    color: var(--soft);
    border: 1px solid var(--lineo);
    background: var(--glasso);
    border-radius: 999px;
    padding: 5px 12px
  }

  .scenario {
    border-left: 2px solid var(--orange);
    background: var(--glasso);
    padding: 14px 18px;
    border-radius: 0 8px 8px 0;
    margin: 22px 0
  }

  .scenario p {
    margin: 0;
    font-size: .9rem;
    color: var(--ink)
  }

  .fade {
    animation: fade .32s var(--ease)
  }

  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(8px)
    }

    to {
      opacity: 1;
      transform: none
    }
  }

  /* ── product mockup ────────────────────────────── */
  .app {
    background: var(--s2);
    border: 1px solid var(--line2);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 0 90px rgba(241, 91, 38, .09)
  }

  .appbar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 15px;
    border-bottom: 1px solid var(--line);
    background: var(--s3)
  }

  .dots {
    display: flex;
    gap: 6px
  }

  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #2a2a2f;
    display: block
  }

  .appbar .t {
    font-family: var(--fm);
    font-size: 10.5px;
    color: var(--faint);
    letter-spacing: .06em
  }

  .appbar .live {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--fm);
    font-size: 9.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ok)
  }

  .appbar .live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
    display: block;
    animation: pulse 2s infinite
  }

  @keyframes pulse {

    0%,
    100% {
      opacity: 1
    }

    50% {
      opacity: .35
    }
  }

  .appbody {
    display: grid;
    grid-template-columns: 52px 1fr;
    min-height: 430px
  }

  .appnav {
    border-right: 1px solid var(--line);
    padding: 12px 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    align-items: center;
    background: var(--s1)
  }

  .appnav i {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    display: grid;
    place-items: center;
    font-style: normal;
    font-size: 12px;
    color: var(--faint);
    font-family: var(--fm)
  }

  .appnav i.on {
    background: var(--glasso);
    color: var(--orange);
    box-shadow: inset 0 0 0 1px var(--lineo)
  }

  .appmain {
    padding: 15px
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(88px, 1fr));
    gap: 7px;
    margin-bottom: 13px
  }

  .kpi {
    background: var(--s1);
    border: 1px solid var(--line);
    border-radius: 9px;
    padding: 9px 10px
  }

  .kpi .k {
    font-family: var(--fm);
    font-size: 8.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--faint);
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis
  }

  .kpi .v {
    font-family: var(--fm);
    font-size: 1.02rem;
    color: var(--strong);
    font-variant-numeric: tabular-nums;
    margin-top: 3px;
    display: block
  }

  .kpi .d {
    font-family: var(--fm);
    font-size: 8.5px;
    margin-top: 2px;
    display: block
  }

  .up {
    color: var(--crit)
  }

  .down {
    color: var(--ok)
  }

  .appsplit {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px
  }

  @media(max-width:560px) {
    .appsplit {
      grid-template-columns: 1fr
    }
  }

  .panel {
    background: var(--s1);
    border: 1px solid var(--line);
    border-radius: 9px;
    padding: 11px;
    min-height: 210px
  }

  .panel .h {
    font-family: var(--fm);
    font-size: 9px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 9px;
    display: flex;
    justify-content: space-between;
    align-items: center
  }

  .panel .h em {
    font-style: normal;
    color: var(--orange)
  }

  .feed {
    display: flex;
    flex-direction: column;
    gap: 7px
  }

  .item {
    border: 1px solid var(--line);
    border-left: 2px solid var(--crit);
    border-radius: 0 7px 7px 0;
    padding: 8px 10px;
    background: var(--s2)
  }

  .item.med {
    border-left-color: var(--warn)
  }

  .item.low {
    border-left-color: var(--ok)
  }

  .item .u {
    font-family: var(--fm);
    font-size: 10px;
    color: var(--soft);
    display: flex;
    justify-content: space-between
  }

  .item .u b {
    font-weight: 400
  }

  .item .u time {
    color: var(--faint)
  }

  .item p {
    font-size: 11.5px;
    margin: 5px 0 6px;
    color: var(--muted);
    line-height: 1.45;
    max-width: none
  }

  .item .tags {
    display: flex;
    gap: 5px;
    flex-wrap: wrap
  }

  .item .tags span {
    font-family: var(--fm);
    font-size: 8.5px;
    letter-spacing: .06em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 999px;
    border: 1px solid var(--line2);
    color: var(--faint)
  }

  .item .tags span.hot {
    color: var(--crit);
    border-color: rgba(255, 77, 31, .4)
  }

  .bars {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 2px
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    align-items: center;
    font-size: 11px
  }

  .bar .n {
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis
  }

  .bar .t {
    width: 100%;
    grid-column: 1/-1;
    height: 4px;
    border-radius: 2px;
    background: var(--s3);
    overflow: hidden
  }

  .bar .t i {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: var(--orange)
  }

  .bar .c {
    font-family: var(--fm);
    font-size: 10.5px;
    color: var(--faint)
  }

  .illus {
    font-family: var(--fm);
    font-size: 9px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--faint);
    margin-top: 11px;
    display: flex;
    align-items: center;
    gap: 7px
  }

  .illus::before {
    content: "";
    width: 14px;
    height: 1px;
    background: var(--line2)
  }

  /* ── capabilities ──────────────────────────────── */
  .caps {
    display: grid;
    gap: 9px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-top: 36px
  }

  details.cap {
    background: var(--s2);
    border: 1px solid var(--line);
    border-radius: 12px;
    transition: .18s var(--ease)
  }

  details.cap:hover {
    background: var(--s3);
    border-color: var(--lineo)
  }

  details.cap[open] {
    background: var(--s3);
    border-color: var(--lineo)
  }

  details.cap summary {
    list-style: none;
    cursor: pointer;
    padding: 20px 22px;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: flex-start
  }

  details.cap summary::-webkit-details-marker {
    display: none
  }

  details.cap summary h3 {
    margin: 0 0 5px;
    color: var(--soft)
  }

  details.cap summary p {
    margin: 0;
    font-size: .85rem
  }

  details.cap summary .pl {
    font-family: var(--fm);
    color: var(--orange);
    flex-shrink: 0;
    font-size: 15px;
    line-height: 1.6
  }

  details.cap[open] summary .pl {
    transform: rotate(45deg)
  }

  .capbody {
    padding: 0 22px 22px;
    border-top: 1px solid var(--line);
    margin-top: 2px;
    padding-top: 16px
  }

  .capbody dl {
    margin: 0;
    display: grid;
    gap: 11px
  }

  .capbody dt {
    font-family: var(--fm);
    font-size: 9px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange)
  }

  .capbody dd {
    margin: 3px 0 0;
    font-size: .85rem;
    color: var(--muted);
    line-height: 1.55
  }

  /* ── flow ──────────────────────────────────────── */
  .flow {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 8px;
    margin-top: 34px
  }

  .fstep {
    background: var(--s2);
    border: 1px solid var(--line);
    border-radius: 11px;
    padding: 18px;
    position: relative
  }

  .fstep .n {
    font-family: var(--fm);
    font-size: 10px;
    color: var(--deep);
    display: block;
    margin-bottom: 9px
  }

  .fstep h3 {
    font-size: .98rem;
    margin-bottom: 5px
  }

  .fstep p {
    font-size: .82rem;
    margin: 0
  }

  /* ── the challenge ─────────────────────────────── */
  .challenge-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 9px;
    margin-top: 34px;
    text-align: left
  }

  .challenge-card {
    --c: var(--orange);
    background: var(--s2);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 26px 24px;
    position: relative;
    transition: .2s var(--ease)
  }

  .challenge-card:hover {
    border-color: color-mix(in srgb, var(--c) 45%, transparent);
    background: var(--s3);
    transform: translateY(-2px)
  }

  .challenge-card .ico {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--c) 55%, transparent);
    color: var(--c);
    margin-bottom: 18px
  }

  .challenge-card .ico svg {
    width: 22px;
    height: 22px
  }

  .challenge-card .n {
    font-family: var(--fm);
    font-size: 12px;
    letter-spacing: .06em;
    color: var(--c);
    display: block;
    margin-bottom: 8px
  }

  .challenge-card h3 {
    margin-bottom: 12px;
    font-size: 1.08rem
  }

  .challenge-card .rule {
    display: block;
    width: 26px;
    height: 2px;
    border-radius: 2px;
    background: var(--c);
    margin-bottom: 14px
  }

  .challenge-card p {
    font-size: .87rem;
    margin: 0
  }

  /* ── understand ────────────────────────────────── */
  .intel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 9px;
    margin-top: 34px;
    text-align: left
  }

  .intel-card {
    background: var(--s2);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 22px;
    transition: .2s var(--ease)
  }

  .intel-card:hover {
    border-color: var(--lineo);
    background: var(--s3)
  }

  .intel-ico {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--glasso);
    color: var(--orange);
    font-size: 16px;
    margin-bottom: 16px
  }

  .intel-card h3 {
    margin-bottom: 6px
  }

  .intel-card p {
    font-size: .87rem;
    margin: 0
  }

  /* ── routes ────────────────────────────────────── */
  .routes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 9px;
    margin-top: 34px
  }

  .route {
    display: block;
    text-decoration: none;
    background: var(--s2);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
    transition: .2s var(--ease)
  }

  .route:hover {
    transform: translateY(-3px);
    border-color: var(--lineo);
    background: var(--s3);
    box-shadow: 0 0 26px rgba(241, 91, 38, .14)
  }

  .route .k {
    font-family: var(--fm);
    font-size: 9.5px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--faint);
    display: block;
    margin-bottom: 12px
  }

  .route h3 {
    color: var(--orange)
  }

  .route p {
    font-size: .85rem;
    margin: 0 0 14px
  }

  .route .go {
    font-family: var(--fm);
    font-size: 11px;
    color: var(--soft)
  }

  /* ── final ─────────────────────────────────────── */
  #final {
    text-align: center;
    padding-top: 130px;
    padding-bottom: 130px
  }

  #final p {
    margin-left: auto;
    margin-right: auto
  }

  .finalrow {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 32px
  }

  .mailnote {
    margin-top: 26px;
    font-family: var(--fm);
    font-size: 11.5px;
    color: var(--faint)
  }

  .mailnote a {
    color: var(--soft);
    text-decoration: none;
    border-bottom: 1px solid var(--lineo)
  }

  footer {
    border-top: 1px solid var(--line);
    padding: 40px clamp(20px, 4vw, 44px);
    background: var(--s1)
  }

  .foot {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 26px;
    flex-wrap: wrap;
    align-items: center
  }

  .foot img {
    height: 26px;
    opacity: .75
  }

  .foot .c {
    font-family: var(--fm);
    font-size: 10.5px;
    color: var(--faint);
    line-height: 1.8
  }

  /* reveal */
  .rv {
    opacity: 0;
    transform: translateY(22px)
  }

  .rv.in {
    opacity: 1;
    transform: none;
    transition: opacity .5s var(--ease), transform .5s var(--ease)
  }

  .rv.d1 {
    transition-delay: .08s
  }

  .rv.d2 {
    transition-delay: .16s
  }

  .rv.d3 {
    transition-delay: .24s
  }

  /* repeatable reveal — animates in AND out every time it crosses the viewport
     (used by sections that should feel alive on every pass, not just the first) */
  .cv {
    opacity: 0;
    transform: translateY(30px) scale(.95);
    transition: opacity .55s var(--ease), transform .55s var(--ease)
  }

  .cv.in {
    opacity: 1;
    transform: none
  }

  .cv.d1 {
    transition-delay: .07s
  }

  .cv.d2 {
    transition-delay: .14s
  }

  .cv.d3 {
    transition-delay: .21s
  }

  @media (prefers-reduced-motion:reduce) {

    .cv,
    .cv.in {
      opacity: 1;
      transform: none;
      transition: none
    }
  }

  /* ── product showcase: macbook + live dashboard ── */
  .showcase {
    text-align: center;
    padding-top: 118px;
    padding-bottom: 90px;
    overflow: hidden
  }

  .showcase .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 1500px
  }

  .showcase h2 {
    margin-bottom: 14px
  }

  .showcase .lead {
    margin-inline: auto
  }

  .mb-device {
    --mb: 0;
    position: relative;
    width: min(1340px, 96%);
    margin: 60px auto 0;
    perspective: 2400px;
    perspective-origin: 50% 18%
  }

  .mb-glow {
    position: absolute;
    left: 50%;
    top: 10%;
    width: 86%;
    height: 78%;
    transform: translateX(-50%);
    background: radial-gradient(58% 54% at 50% 50%, rgba(241, 91, 38, .34), rgba(241, 91, 38, .07) 55%, transparent 72%);
    filter: blur(50px);
    opacity: calc(.2 + var(--mb) * .8);
    pointer-events: none
  }

  .mb-rig {
    position: relative;
    transform-style: preserve-3d;
    transform-origin: 50% 100%;
    transform:
      translateY(calc((1 - var(--mb)) * 130px)) rotateX(calc((1 - var(--mb)) * 15deg)) scale(calc(.9 + var(--mb) * .1));
    will-change: transform
  }

  /* the device is a real MacBook Pro frame PNG with a transparent screen cut-out;
     the OS + dashboard sit behind it, so the bezel, notch and rounded corners mask them */
  .mb-shell {
    position: relative;
    aspect-ratio: 3944/2564
  }

  .mb-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    pointer-events: none;
    filter: drop-shadow(0 40px 70px rgba(0, 0, 0, .62))
  }

  /* the screen hole, measured from the PNG's alpha channel */
  .mb-screen {
    position: absolute;
    left: 11.689%;
    top: 11.740%;
    width: 76.622%;
    height: 76.521%;
    overflow: hidden;
    background: #000;
    z-index: 1
  }

  .mb-glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background:
      linear-gradient(112deg, rgba(255, 255, 255, .16) 0 16%, transparent 40%),
      radial-gradient(120% 78% at 50% -12%, rgba(255, 255, 255, .1), transparent 56%);
    mix-blend-mode: screen;
    opacity: calc(.62 - var(--mb) * .42)
  }

  /* ── macOS desktop inside the screen ── */
  .mb-os {
    width: 1510px;
    height: 980px;
    transform-origin: 0 0;
    transform: scale(var(--sd-s, .5));
    display: flex;
    flex-direction: column;
    background: #F4F6FA;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif
  }

  .mb-menubar {
    height: 30px;
    flex: none;
    background: #000;
    color: rgba(255, 255, 255, .92);
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 0 16px;
    font-size: 12.5px;
    letter-spacing: .01em
  }

  .mb-menubar .apple {
    width: 13px;
    height: 16px;
    margin-right: -6px;
    flex: none
  }

  .mb-menubar .mi {
    width: 16px;
    height: 16px;
    flex: none;
    opacity: .92
  }

  .mb-menubar .app {
    font-weight: 700
  }

  .mb-menubar .right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 15px
  }

  .mb-menubar .batt {
    width: 22px;
    height: 11px;
    border: 1.3px solid rgba(255, 255, 255, .75);
    border-radius: 3.5px;
    position: relative;
    display: inline-block
  }

  .mb-menubar .batt::before {
    content: "";
    position: absolute;
    inset: 1.5px;
    right: auto;
    width: 72%;
    background: #fff;
    border-radius: 1.5px
  }

  .mb-menubar .batt::after {
    content: "";
    position: absolute;
    right: -3.5px;
    top: 3px;
    bottom: 3px;
    width: 1.8px;
    background: rgba(255, 255, 255, .75);
    border-radius: 0 2px 2px 0
  }

  /* ── the dashboard rendered inside the screen ── */
  .sd-viewport {
    width: 1510px;
    flex: 1;
    min-height: 0;
    display: flex;
    background: #F4F6FA;
    color: #111827;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: 13px;
    line-height: 1.4;
    text-align: left;
    letter-spacing: 0
  }

  .sd-viewport p {
    margin: 0;
    max-width: none;
    color: inherit
  }

  /* sidebar */
  .sd-side {
    width: 226px;
    flex: none;
    background: linear-gradient(180deg, #E1352C, #EE5729 46%, #F3771C);
    color: #fff;
    padding: 15px 13px;
    display: flex;
    flex-direction: column
  }

  .sd-brand {
    display: flex;
    align-items: center;
    padding: 0 2px 15px
  }

  .sd-brand img {
    height: 46px;
    width: auto;
    border-radius: 9px;
    background: #fff;
    padding: 4px 9px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, .16)
  }

  .sd-nav-active {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    color: #E1352C;
    font-weight: 600;
    border-radius: 10px;
    padding: 11px 13px;
    margin-bottom: 14px;
    box-shadow: 0 4px 12px rgba(0, 0, 0, .12)
  }

  .sd-group {
    font-size: 9px;
    letter-spacing: .11em;
    text-transform: uppercase;
    opacity: .72;
    margin: 12px 0 5px 6px
  }

  .sd-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 9px;
    border-radius: 8px;
    font-size: 12.5px;
    color: rgba(255, 255, 255, .95)
  }

  .sd-link .sd-ico {
    width: 15px;
    text-align: center;
    opacity: .9;
    flex: none
  }

  .sd-link .sd-badge {
    margin-left: auto;
    background: #B3170F;
    border-radius: 999px;
    font-size: 9.5px;
    font-weight: 600;
    padding: 1px 7px
  }

  .sd-status {
    margin-top: auto;
    background: rgba(255, 255, 255, .13);
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: 11px;
    padding: 11px
  }

  .sd-status .h {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    margin-bottom: 8px
  }

  .sd-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ADE80;
    box-shadow: 0 0 0 0 rgba(74, 222, 128, .7);
    animation: sdPulse 2.2s infinite
  }

  @keyframes sdPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(74, 222, 128, .65)
    }

    70% {
      box-shadow: 0 0 0 7px rgba(74, 222, 128, 0)
    }

    100% {
      box-shadow: 0 0 0 0 rgba(74, 222, 128, 0)
    }
  }

  .sd-status .p {
    background: #fff;
    color: #E1352C;
    font-size: 11px;
    font-weight: 600;
    text-align: center;
    border-radius: 7px;
    padding: 6px
  }

  .sd-ver {
    font-size: 10px;
    opacity: .7;
    margin: 9px 0 0 4px
  }

  /* main */
  .sd-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column
  }

  .sd-top {
    height: 62px;
    flex: none;
    background: #fff;
    border-bottom: 1px solid #E9EDF3;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 18px
  }

  .sd-search {
    flex: 1;
    max-width: 470px;
    display: flex;
    align-items: center;
    gap: 9px;
    height: 38px;
    border: 1px solid #E2E7EF;
    border-radius: 10px;
    padding: 0 12px;
    color: #98A2B3;
    font-size: 12.5px
  }

  .sd-search .k {
    margin-left: auto;
    border: 1px solid #E2E7EF;
    border-radius: 5px;
    font-size: 10px;
    padding: 1px 5px
  }

  .sd-genbtn {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(180deg, #F2542D, #E5372B);
    color: #fff;
    font-weight: 600;
    font-size: 12.5px;
    border-radius: 9px;
    padding: 10px 16px;
    box-shadow: 0 4px 12px rgba(229, 55, 43, .3)
  }

  .sd-icobtn {
    position: relative;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid #E9EDF3;
    display: grid;
    place-items: center;
    color: #667085;
    font-size: 13px;
    flex: none
  }

  .sd-icobtn .n {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 17px;
    height: 17px;
    border-radius: 999px;
    background: #E5372B;
    color: #fff;
    font-size: 9.5px;
    font-weight: 600;
    display: grid;
    place-items: center;
    padding: 0 4px
  }

  .sd-user {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: none
  }

  .sd-user .av {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: linear-gradient(140deg, #F2764B, #C63A1E);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 600
  }

  .sd-user b {
    display: block;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.25
  }

  .sd-user span {
    display: block;
    font-size: 10.5px;
    color: #98A2B3;
    line-height: 1.25
  }

  .sd-body {
    flex: 1;
    min-height: 0;
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px
  }

  .sd-filters {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none
  }

  .sd-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    background: #fff;
    border: 1px solid #E4E9F0;
    border-radius: 10px;
    padding: 0 13px;
    font-size: 12px;
    color: #344054;
    white-space: nowrap
  }

  .sd-pill .cr {
    color: #98A2B3;
    font-size: 9px
  }

  .sd-plats {
    display: flex;
    align-items: center;
    gap: -4px
  }

  .sd-plat {
    width: 25px;
    height: 25px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    border: 2px solid #fff;
    margin-left: -7px
  }

  .sd-plat:first-child {
    margin-left: 0
  }

  .sd-custom {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    background: #fff;
    border: 1px solid #FBD9CE;
    color: #E5372B;
    font-weight: 600;
    border-radius: 10px;
    padding: 0 14px;
    font-size: 12px;
    white-space: nowrap
  }

  /* cards */
  .sd-card {
    background: #fff;
    border: 1px solid #EAEEF4;
    border-radius: 13px;
    padding: 11px 13px;
    box-shadow: 0 1px 2px rgba(16, 24, 40, .04)
  }

  .sd-card .ch {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 11px
  }

  .sd-card .ch b {
    font-size: 13.5px;
    font-weight: 600
  }

  .sd-mini {
    display: flex;
    align-items: center;
    gap: 5px;
    border: 1px solid #E4E9F0;
    border-radius: 7px;
    padding: 3px 8px;
    font-size: 10.5px;
    color: #667085;
    white-space: nowrap
  }

  .sd-kpis {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    flex: none
  }

  .sd-kpi .t {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px
  }

  .sd-kpi .lbl {
    font-size: 12.5px;
    color: #475467;
    font-weight: 500
  }

  .sd-kpi .ic {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 13px;
    flex: none
  }

  .sd-kpi .v {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -.02em;
    margin-top: 7px;
    font-variant-numeric: tabular-nums;
    display: flex;
    align-items: baseline;
    gap: 8px
  }

  .sd-kpi .d {
    font-size: 11.5px;
    font-weight: 600
  }

  .sd-kpi .sub {
    font-size: 10.5px;
    color: #98A2B3;
    margin-top: 3px
  }

  .sd-up {
    color: #12B76A
  }

  .sd-dn {
    color: #E5372B
  }

  .sd-spark {
    display: block;
    width: 100%;
    height: 33px;
    margin-top: 5px
  }

  .sd-spark polyline {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: all .9s var(--ease)
  }

  .sd-row {
    display: grid;
    gap: 9px;
    flex: none
  }

  .sd-r2 {
    grid-template-columns: 1fr 1fr 1.28fr
  }

  .sd-r3 {
    grid-template-columns: 1fr 1fr 1fr 1fr
  }

  .sd-r4 {
    grid-template-columns: 1.5fr 1.05fr 1fr;
    flex: none;
    min-height: 176px
  }

  /* donuts */
  .sd-donut {
    display: flex;
    align-items: center;
    gap: 14px
  }

  .sd-donut svg {
    flex: none;
    width: 104px;
    height: 104px
  }

  .sd-donut circle {
    transition: stroke-dasharray 1.1s var(--ease)
  }

  .sd-donut .mid {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -.02em
  }

  .sd-donut .midl {
    font-size: 9.5px;
    fill: #98A2B3
  }

  .sd-leg {
    display: grid;
    gap: 11px;
    flex: 1;
    min-width: 0
  }

  .sd-leg div {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px
  }

  .sd-leg i {
    width: 9px;
    height: 9px;
    border-radius: 3px;
    flex: none
  }

  .sd-leg .n {
    margin-left: auto;
    font-weight: 600;
    font-variant-numeric: tabular-nums
  }

  .sd-leg .pct {
    color: #98A2B3;
    font-size: 11px;
    width: 52px;
    text-align: right
  }

  /* trending */
  .sd-trend {
    display: grid;
    gap: 4px
  }

  .sd-trend div {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 0;
    font-size: 12px;
    border-bottom: 1px solid #F2F4F7
  }

  .sd-trend div:last-child {
    border-bottom: 0
  }

  .sd-trend .r {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: #FEF0EC;
    color: #E5372B;
    font-size: 10.5px;
    font-weight: 700;
    display: grid;
    place-items: center;
    flex: none
  }

  .sd-trend .tag {
    font-weight: 600;
    width: 108px;
    flex: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap
  }

  .sd-trend .m {
    color: #667085;
    font-size: 11px;
    width: 92px;
    flex: none
  }

  .sd-trend .c {
    font-size: 11px;
    font-weight: 600;
    width: 54px;
    flex: none
  }

  .sd-trend svg {
    flex: 1;
    height: 20px;
    min-width: 0
  }

  /* platform bars */
  .sd-plist {
    display: grid;
    gap: 9px
  }

  .sd-prow {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 11.5px
  }

  .sd-prow .nm {
    width: 74px;
    flex: none;
    color: #344054
  }

  .sd-prow .tr {
    flex: 1;
    height: 7px;
    border-radius: 4px;
    background: #F2F4F7;
    overflow: hidden;
    min-width: 0
  }

  .sd-prow .tr i {
    display: block;
    height: 100%;
    border-radius: 4px;
    transition: width 1.1s var(--ease)
  }

  .sd-prow .vv {
    width: 82px;
    flex: none;
    text-align: right;
    font-weight: 600;
    font-variant-numeric: tabular-nums
  }

  .sd-prow .vv span {
    color: #98A2B3;
    font-weight: 400
  }

  /* list rows */
  .sd-list {
    display: grid;
    gap: 3px
  }

  .sd-lrow {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 5px 0;
    font-size: 11.5px;
    border-bottom: 1px solid #F2F4F7
  }

  .sd-lrow:last-child {
    border-bottom: 0
  }

  .sd-lrow .nm {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #1D2939
  }

  .sd-lrow .ag {
    color: #98A2B3;
    font-size: 10.5px;
    flex: none
  }

  .sd-chip {
    font-size: 9.5px;
    font-weight: 600;
    border-radius: 999px;
    padding: 2px 8px;
    flex: none
  }

  .sd-hi {
    background: #FEE4E2;
    color: #D92D20
  }

  .sd-md {
    background: #FEF0C7;
    color: #B54708
  }

  .sd-lo {
    background: #D1FADF;
    color: #027A48
  }

  .sd-nw {
    background: #E0F2FE;
    color: #026AA2
  }

  .sd-ip {
    background: #EEF4FF;
    color: #3538CD
  }

  .sd-viewall {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid #F2F4F7;
    color: #2E6BE6;
    font-size: 11.5px;
    font-weight: 600
  }

  .sd-viewall .n {
    background: #E5372B;
    color: #fff;
    border-radius: 999px;
    font-size: 9.5px;
    padding: 1px 7px
  }

  /* heatmap */
  .sd-heat {
    position: relative;
    height: 108px
  }

  .sd-heat svg {
    position: absolute;
    inset: 0 0 0 auto;
    width: 76%;
    height: 100%
  }

  .sd-india {
    fill: #EEF1F6;
    stroke: #C6CFDC;
    stroke-width: .7;
    stroke-linejoin: round
  }

  .sd-blob {
    transform-box: fill-box;
    transform-origin: center;
    animation: sdBlob 3.4s ease-in-out infinite
  }

  @keyframes sdBlob {

    0%,
    100% {
      transform: scale(.72);
      opacity: .7
    }

    50% {
      transform: scale(1.15);
      opacity: 1
    }
  }

  .sd-heatleg {
    position: absolute;
    left: 0;
    bottom: 0;
    display: grid;
    gap: 3px;
    font-size: 9.5px;
    color: #667085
  }

  .sd-heatleg div {
    display: flex;
    align-items: center;
    gap: 5px
  }

  .sd-heatleg i {
    width: 8px;
    height: 8px;
    border-radius: 2px
  }

  /* live feed */
  .sd-feed {
    display: grid;
    gap: 8px;
    overflow: hidden
  }

  .sd-fitem {
    display: flex;
    gap: 10px;
    padding: 6px 9px;
    border: 1px solid #EEF1F6;
    border-radius: 10px;
    background: #FCFDFE;
    animation: sdIn .55s var(--ease)
  }

  @keyframes sdIn {
    from {
      opacity: 0;
      transform: translateY(-13px)
    }

    to {
      opacity: 1;
      transform: none
    }
  }

  .sd-fitem .pv {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    flex: none
  }

  .sd-fitem .bd {
    flex: 1;
    min-width: 0
  }

  .sd-fitem .hd {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px
  }

  .sd-fitem .hd b {
    font-weight: 600
  }

  .sd-fitem .hd time {
    color: #98A2B3;
    font-size: 10.5px
  }

  .sd-fitem p {
    font-size: 10.5px;
    color: #475467;
    margin: 2px 0 4px !important;
    line-height: 1.35
  }

  .sd-fitem .mt {
    display: flex;
    align-items: center;
    gap: 6px
  }

  .sd-fitem .rr {
    text-align: right;
    flex: none;
    width: 62px
  }

  .sd-fitem .rr .k {
    font-size: 9px;
    color: #98A2B3;
    display: block
  }

  .sd-fitem .rr .v {
    font-size: 12px;
    font-weight: 700;
    font-variant-numeric: tabular-nums
  }

  .sd-live {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #FEE4E2;
    color: #D92D20;
    font-size: 10px;
    font-weight: 600;
    border-radius: 999px;
    padding: 3px 9px
  }

  .sd-live i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #D92D20;
    animation: sdPulse 1.6s infinite
  }

  /* assistant + quick actions */
  .sd-ai {
    display: flex;
    align-items: center;
    gap: 11px;
    background: linear-gradient(120deg, #F4F0FF, #EEF4FF);
    border: 1px solid #E4E4FB;
    border-radius: 12px;
    padding: 13px
  }

  .sd-ai .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(140deg, #7C6BF5, #4E7BEE);
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 16px;
    flex: none;
    animation: sdOrb 3s ease-in-out infinite
  }

  @keyframes sdOrb {

    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(124, 107, 245, .45)
    }

    60% {
      box-shadow: 0 0 0 12px rgba(124, 107, 245, 0)
    }
  }

  .sd-ai .ph {
    flex: 1;
    color: #98A2B3;
    font-size: 11.5px
  }

  .sd-ai .snd {
    color: #4E7BEE;
    font-size: 15px
  }

  .sd-qa {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px
  }

  .sd-qa div {
    border: 1px solid #EAEEF4;
    border-radius: 10px;
    padding: 12px 6px;
    text-align: center;
    font-size: 10.5px;
    color: #344054;
    font-weight: 500
  }

  .sd-qa div span {
    display: block;
    font-size: 15px;
    margin-bottom: 5px;
    color: #667085
  }

  @media(max-width:760px) {
    .showcase {
      padding-top: 88px;
      padding-bottom: 60px
    }

    .mb-device {
      margin-top: 40px
    }
  }

  @media (prefers-reduced-motion:reduce) {
    html {
      scroll-behavior: auto
    }

    .mb-rig {
      transform: none
    }

    .sd-dot,
    .sd-live i,
    .sd-ai .orb,
    .sd-heat .blob,
    .sd-fitem {
      animation: none
    }

    .rv {
      opacity: 1;
      transform: none;
      transition: none
    }

    .appbar .live i {
      animation: none
    }

    .pin {
      height: auto
    }

    .pin .sticky {
      position: static;
      height: auto;
      padding-top: 80px;
      padding-bottom: 80px
    }

    .fade {
      animation: none
    }
  }
</style>

