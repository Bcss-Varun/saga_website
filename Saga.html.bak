<script>
  /* ═══════════════ content model ═══════════════ */
  const WLABEL = { police: 'Angular · grid · investigative', political: 'Territorial · regional · tidal', brand: 'Radial · outward · accelerating', celebrity: 'Organic · clustered · orbital' };
  const WORLDS = {
    police: {
      name: 'Police Saga', title: 'See threats earlier. Investigate faster. Act with evidence.',
      body: 'Watch the conversations that precede an incident, resolve who is behind them, and carry a clean evidence trail from first signal to closed case.',
