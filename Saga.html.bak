    },
    political: {
      name: 'Political Saga', title: 'Understand sentiment. See where it moves. Act before it escalates.',
      body: 'Constituency-level sentiment, live grievance routing and early warning on unrest — so you know which regions need attention this week, not after the next election.',
      chips: ['Constituency sentiment', 'Grievance routing', 'Unrest risk', 'Voter profiling', 'Issue tracking'],
      scenario: 'Negative sentiment in four adjacent constituencies rises 18 points over nine days, all tied to one water-supply issue. SAGA surfaces the pattern, routes the grievances to the right department, and tracks the sentiment recovery after the fix.',
      app: {
        title: 'saga · political intelligence · state deployment', navOn: 1,
