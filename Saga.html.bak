        feedTitle: 'Crisis watch', feedTag: '1 escalating',
        feed: [
          { u: '@handle_1187', t: '6h proj.', r: '', x: 'Product complaint projected to cross 100k views. Three amplifier accounts identified.', tags: ['Viral: high', 'Originating source', 'Escalating'] },
          { u: '@handle_5502', t: '3h', r: 'med', x: 'Service delay thread gaining traction in one metro region only.', tags: ['Medium', 'Location cluster'] },
          { u: '@handle_7741', t: '1h', r: 'low', x: 'Positive coverage from a category publication offsetting the negative trend.', tags: ['Positive', 'Earned media'] }],
        panelTitle: 'Sentiment by channel', panelTag: 'live',
        bars: [['Social — X', 74], ['Social — Instagram', 58], ['News &amp; web', 47], ['Video platforms', 33], ['Forums', 21]]
      }
    },
    celebrity: {
      name: 'Celebrity Saga', title: 'Understand reputation, fans, influence and attack patterns.',
      body: 'Tell a genuine fan backlash apart from a coordinated troll operation — and see which endorsements are actually moving perception.',
      chips: ['Fan sentiment', 'Troll &amp; bot detection', 'Coordinated attack patterns', 'Endorsement intelligence', 'Regional language reach'],
      scenario: 'A negative trend spikes overnight. SAGA shows 71% of the volume comes from accounts under 90 days old posting in a 40-minute window — a coordinated push, not a fan reaction. The response strategy changes completely.',
      app: {
        title: 'saga · celebrity intelligence · reputation &amp; fandom', navOn: 3,
        kpis: [['Mentions', '64,290', '↗ 47.3%', 'up'], ['Genuine fans', '29.1%', '↘ 22.0%', 'down'], ['Suspected bots', '71%', '↗', 'up'], ['Sentiment', '−0.34', '↘', 'up'], ['Endorsements', '6', '—', '']],
        feedTitle: 'Attack pattern detected', feedTag: 'coordinated',
        feed: [
          { u: 'Cluster A · 412 accounts', t: '40 min', r: '', x: '71% of negative volume from accounts under 90 days old, posting inside one 40-minute window.', tags: ['Coordinated', 'Bot cluster', 'High confidence'] },
          { u: 'Cluster B · 78 accounts', t: '2h', r: 'med', x: 'Recycled content from an unrelated older controversy being re-attributed.', tags: ['Medium', 'Misinformation'] },
          { u: 'Organic fan volume', t: 'ongoing', r: 'low', x: 'Genuine fan accounts responding in defence. Regional-language sentiment holding positive.', tags: ['Organic', 'Telugu', 'Positive'] }],
        panelTitle: 'Audience composition', panelTag: 'estimated',
        bars: [['Suspected coordinated', 71], ['Genuine fans', 29], ['Regional language', 54], ['Media &amp; press', 12], ['Endorsement-linked', 8]]
      }
    }
  };

  const CAPS = [
    ['What are people saying?', 'Monitor', 'Continuous capture across social platforms, news, RSS and the open web — in English and regional languages, with inline translation.', 'Every source you care about, watched without anyone having to refresh a page.', 'Run keyword watchlists, track named profiles and monitor events and calendars without manual searching.'],
    ['What does it mean?', 'Analyze', 'Sentiment, intent, topic and entity analysis on every incoming signal, plus AI summarisation of long threads.', 'You read conclusions, not raw feeds.', 'Classify by topic, extract entities, and summarise a hundred posts into one paragraph.'],
    ['What looks risky?', 'Detect', 'Threat signals, risk scoring, narrative and campaign detection, and misinformation identification.', 'The difference between a hundred angry posts and one organised campaign.', 'Separate organic anger from a manufactured push, and score how serious each is.'],
    ['What happens next?', 'Predict', 'Trend forecasting, escalation likelihood, viral-risk projection and unrest early warning.', 'Time to act instead of time to react.', 'See which issue is about to become a problem, and roughly when.'],
    ['Where is it happening?', 'Locate', 'Geospatial intelligence down to constituency, district and ward level, with sentiment mapped to place.', 'A map tells you where to send people. A list does not.', 'Compare regions, spot clusters, and watch an issue move across a boundary.'],
    ['Who is behind it?', 'Investigate', 'Identity resolution, network analysis, cross-platform search, deepfake verification and the SOC-EYE AI assistant.', 'From a single post to the network behind it.', 'Trace an account across platforms, map its connections, and verify whether media is authentic.'],
    ['What do we do about it?', 'Manage &amp; Govern', 'Alerts, cases, assignment, grievance routing and automated reporting — under role-based access control and full audit trails.', 'Intelligence that ends in an action someone owns.', 'Route work to the right team, and prove afterwards who saw what and when.']
  ];

  /* ═══════════════ worlds UI ═══════════════ */
  const wcopy = document.getElementById('wcopy'), wapp = document.getElementById('wapp'),
    rail = document.getElementById('rail'), ind = document.getElementById('ind'),
    tabs = [...rail.querySelectorAll('button')];
  let current = 'police';

  const esc = s => s;
  function renderWorld(k) {
    const w = WORLDS[k], a = w.app;
    wcopy.className = 'worldcopy fade';
    wcopy.innerHTML = `<h2>${w.title}</h2><p>${w.body}</p>
    <div class="chips">${w.chips.map(c => `<span>${c}</span>`).join('')}</div>
    <div class="scenario"><p>${w.scenario}</p></div>
    <a class="cta" href="#final">Request a ${w.name} demo</a>`;
    wapp.className = 'fade';
    wapp.innerHTML = `<div class="app">
    <div class="appbar"><span class="dots"><i></i><i></i><i></i></span>
      <span class="t">${a.title}</span><span class="live"><i></i>Live</span></div>
    <div class="appbody">
      <div class="appnav">${[...Array(9)].map((_, i) => `<i class="${i === a.navOn ? 'on' : ''}">${'▦◍▤◈⚑▣✦◐⚙'[i]}</i>`).join('')}</div>
      <div class="appmain">
        <div class="kpis">${a.kpis.map(([k, v, d, c]) => `<div class="kpi"><span class="k">${k}</span><span class="v">${v}</span><span class="d ${c}">${d}</span></div>`).join('')}</div>
        <div class="appsplit">
          <div class="panel"><div class="h">${a.feedTitle}<em>${a.feedTag}</em></div>
            <div class="feed">${a.feed.map(f => `<div class="item ${f.r}">
              <div class="u"><b>${f.u}</b><time>${f.t}</time></div><p>${f.x}</p>
              <div class="tags">${f.tags.map((t, i) => `<span class="${i === 0 && !f.r ? 'hot' : ''}">${t}</span>`).join('')}</div></div>`).join('')}</div></div>
          <div class="panel"><div class="h">${a.panelTitle}<em>${a.panelTag}</em></div>
            <div class="bars">${a.bars.map(([n, v]) => `<div class="bar"><span class="n">${n}</span><span class="c">${v}</span><span class="t"><i style="width:${v}%"></i></span></div>`).join('')}</div>
          </div>
        </div>
        <div class="illus">Illustrative data — not a live deployment</div>
      </div>
    </div></div>`;
  }
  function moveInd(btn) { ind.style.width = btn.offsetWidth + 'px'; ind.style.transform = `translateX(${btn.offsetLeft - 4}px)`; }
  function select(k, focus) {
    current = k;
    tabs.forEach(t => { const on = t.dataset.w === k; t.setAttribute('aria-selected', on); if (on) { moveInd(t); if (focus) t.focus(); wcopy.setAttribute('aria-labelledby', t.id); } });
    renderWorld(k); const wl = document.getElementById('wlabel'); if (wl) wl.textContent = WLABEL[k];
    if (window.SCENE) SCENE.morph(k);
  }
  tabs.forEach(t => t.addEventListener('click', () => select(t.dataset.w)));
  rail.addEventListener('keydown', e => {
    const i = tabs.findIndex(t => t.dataset.w === current); let n = null;
    if (e.key === 'ArrowRight') n = (i + 1) % tabs.length; if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
    if (e.key === 'Home') n = 0; if (e.key === 'End') n = tabs.length - 1;
    if (n !== null) { e.preventDefault(); select(tabs[n].dataset.w, true); }
  });
  document.querySelectorAll('[data-go]').forEach(a => a.addEventListener('click', () => select(a.dataset.go)));
  select('police'); addEventListener('resize', () => moveInd(tabs.find(t => t.dataset.w === current)));
  setTimeout(() => moveInd(tabs.find(t => t.dataset.w === current)), 300);

  /* capabilities */
  document.getElementById('capgrid').innerHTML = CAPS.map(([q, g, what, why, does]) => `
  <details class="cap"><summary><div><h3>${q}</h3><p>${g}</p></div><span class="pl">+</span></summary>
    <div class="capbody"><dl>
      <dt>What it is</dt><dd>${what}</dd>
      <dt>Why it matters</dt><dd>${why}</dd>
      <dt>What it lets you do</dt><dd>${does}</dd>
    </dl></div></details>`).join('');

  /* reveals */
  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .15 });
  document.querySelectorAll('.rv').forEach(el => io.observe(el));

  /* repeatable reveal (.cv) — toggles on every entry/exit instead of firing once */
  const cio = new IntersectionObserver(es => es.forEach(e =>
    e.target.classList.toggle('in', e.isIntersecting)), { threshold: .15 });
  document.querySelectorAll('.cv').forEach(el => cio.observe(el));
  let lastY = 0, ticking = false;
  const heroEl = document.getElementById('hero'), frameBg = document.getElementById('heroFrameBg'), lightBg = document.getElementById('heroLightBg');
  const SHRINK = 280;
  function frameTick() {
    const y = scrollY, nav = document.getElementById('nav'), diff = y - lastY;
    const p = Math.min(1, Math.max(0, y / SHRINK));
    document.documentElement.style.setProperty('--p', p);

    if (y > 80) {
      nav.classList.add('floating');
      if (diff > 6 && y > 200) nav.classList.add('hidden');
      else if (diff < -6) nav.classList.remove('hidden');
    } else {
      nav.classList.remove('floating', 'hidden');
    }
    document.body.classList.toggle('scrolled', p >= 1);

    const r = heroEl.getBoundingClientRect();
    if (r.bottom > 0 && r.top < innerHeight) {
      const cs = getComputedStyle(heroEl);
      const mt = parseFloat(cs.marginTop), ml = parseFloat(cs.marginLeft), mr = parseFloat(cs.marginRight), mb = parseFloat(cs.marginBottom);

      lightBg.classList.add('show');
      lightBg.style.top = (r.top - mt) + 'px';
      lightBg.style.left = (r.left - ml) + 'px';
      lightBg.style.width = (r.width + ml + mr) + 'px';
      lightBg.style.height = (r.height + mt + mb) + 'px';

      frameBg.classList.add('show');
      frameBg.style.top = r.top + 'px';
      frameBg.style.left = r.left + 'px';
      frameBg.style.width = r.width + 'px';
      frameBg.style.height = r.height + 'px';
      frameBg.style.borderRadius = (28 * (1 - p)) + 'px';
    } else {
      frameBg.classList.remove('show');
      lightBg.classList.remove('show');
    }

    lastY = y;
    ticking = false;
  }
  addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(frameTick); ticking = true; }
  }, { passive: true });
  addEventListener('resize', frameTick, { passive: true });
  frameTick();
</script>

<script>/* ═══ macbook showcase — scroll rise + live dashboard ═══ */
  (() => {
    const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const device = document.getElementById('mbDevice');
    const vp = document.getElementById('sdViewport');
    const os = document.getElementById('mbOs');
    const screenEl = os.parentElement;

    /* keep the 1440×980 dashboard scaled to whatever the screen area is */
    const fit = () => os.style.setProperty('--sd-s', screenEl.clientWidth / 1510);
    new ResizeObserver(fit).observe(screenEl); fit();

    /* rise as the device scrolls into view */
    let raf = false;
    const rise = () => {
      raf = false;
      const r = device.getBoundingClientRect();
      const start = innerHeight * .96, end = innerHeight * .42;
      const p = Math.min(1, Math.max(0, (start - r.top) / (start - end)));
      device.style.setProperty('--mb', RM ? 1 : p);
    };
    addEventListener('scroll', () => { if (!raf) { requestAnimationFrame(rise); raf = true; } }, { passive: true });
    addEventListener('resize', rise, { passive: true }); rise();

    /* ── data ───────────────────────────────────────── */
    const rnd = (a, b) => a + Math.random() * (b - a);
    const fmt = n => n >= 1e6 ? (n / 1e6).toFixed(2) + 'M' : n >= 1e3 ? (n / 1e3).toFixed(2) + 'K' : Math.round(n);
    const spark = (n, up) => {
      let pts = [], v = rnd(30, 55);
      for (let i = 0; i < n; i++) { v += rnd(-9, up ? 12 : 7); v = Math.max(8, Math.min(52, v)); pts.push(`${(i / (n - 1) * 100).toFixed(1)},${(60 - v).toFixed(1)}`); }
      return pts.join(' ');
    };

    const kpis = [
      { lbl: 'Total Mentions', v: 2.45e6, d: 12.4, up: 1, c: '#2E6BE6', bg: '#EAF1FE', ic: '📈' },
      { lbl: 'High Risk Alerts', v: 186, d: -8.7, up: 0, c: '#E5372B', bg: '#FEE4E2', ic: '⚠' },
      { lbl: 'Grievances', v: 1.32e3, d: 15.1, up: 1, c: '#7C4DFF', bg: '#F0EBFF', ic: '💬' },
      { lbl: 'Positive Sentiment', v: 62.8, d: 6.3, up: 1, c: '#12B76A', bg: '#D1FADF', ic: '☺', pct: 1 },
      { lbl: 'Potential Reach', v: 98.6e6, d: 18.9, up: 1, c: '#2E6BE6', bg: '#EAF1FE', ic: '👥' }
    ];
    document.getElementById('sdKpis').innerHTML = kpis.map((k, i) => `
      <div class="sd-card sd-kpi">
        <div class="t"><div class="lbl">${k.lbl}</div><div class="ic" style="background:${k.bg};color:${k.c}">${k.ic}</div></div>
        <div class="v"><span data-kv="${i}">${k.pct ? k.v.toFixed(1) + '%' : fmt(k.v)}</span>
          <span class="d ${k.d > 0 ? 'sd-up' : 'sd-dn'}">${k.d > 0 ? '▲' : '▼'} ${Math.abs(k.d)}%</span></div>
        <div class="sub">vs May 05 – May 11</div>
        <svg class="sd-spark" viewBox="0 0 100 60" preserveAspectRatio="none">
          <polyline data-sp="${i}" points="${spark(22, k.up)}" stroke="${k.c}"/></svg>
      </div>`).join('');

    const sent = [{ n: 'Positive', c: '#12B76A', p: 62.8 }, { n: 'Neutral', c: '#2E6BE6', p: 23.7 }, { n: 'Negative', c: '#E5372B', p: 13.5 }];
    const risk = [{ n: 'High Risk', c: '#E5372B', p: 7.6, v: 186 }, { n: 'Medium Risk', c: '#F79009', p: 30.3, v: 743 }, { n: 'Low Risk', c: '#12B76A', p: 62.1, v: 1520 }];
    const legend = (el, rows, tot) => el.innerHTML = rows.map(r => `
      <div><i style="background:${r.c}"></i>${r.n}
        <b class="n">${r.v !== undefined ? (r.v >= 1000 ? (r.v / 1000).toFixed(2) + 'K' : r.v) : r.p.toFixed(1) + '%'}</b>
        <span class="pct">(${r.v !== undefined ? r.p.toFixed(1) + '%' : fmt(tot * r.p / 100)})</span></div>`).join('');
    legend(document.getElementById('sdSentLeg'), sent, 2.45e6);
    legend(document.getElementById('sdRiskLeg'), risk);

    const C = 2 * Math.PI * 52;
    const arcs = (sel, rows) => {
      let off = 0;
      document.querySelectorAll(sel).forEach((c, i) => {
        const len = C * rows[i].p / 100;
        c.setAttribute('stroke-dasharray', `${len} ${C - len}`);
        c.setAttribute('stroke-dashoffset', -off);
        off += len;
      });
    };
    const drawArcs = () => { arcs('.sdSeg', sent); arcs('.sdRisk', risk); };
    setTimeout(drawArcs, 260);

    const trend = [
      { t: '#Election2025', m: 245, c: 23.5 }, { t: '#CityProtests', m: 189, c: 18.7 },
      { t: '#FuelPriceHike', m: 143, c: 12.1 }, { t: '#NewPolicy', m: 98, c: 9.3 }, { t: '#SportsFinal', m: 76, c: -2.1 }
    ];
    const drawTrend = () => document.getElementById('sdTrend').innerHTML = trend.map((t, i) => `
      <div><span class="r">${i + 1}</span><span class="tag">${t.t}</span>
        <span class="m">${t.m}K Mentions</span>
        <span class="c ${t.c > 0 ? 'sd-up' : 'sd-dn'}">${t.c > 0 ? '▲' : '▼'} ${Math.abs(t.c).toFixed(1)}%</span>
        <svg viewBox="0 0 100 60" preserveAspectRatio="none"><polyline points="${spark(16, t.c > 0)}"
          fill="none" stroke="${t.c > 0 ? '#2E6BE6' : '#E5372B'}" stroke-width="3" stroke-linecap="round"/></svg></div>`).join('');
    drawTrend();

    const plats = [
      { n: 'X (Twitter)', c: '#000', v: 1.25e6, p: 51.0, w: 100 }, { n: 'Facebook', c: '#1877F2', v: 620e3, p: 25.3, w: 50 },
      { n: 'Instagram', c: '#DD2A7B', v: 320e3, p: 13.1, w: 26 }, { n: 'YouTube', c: '#FF0000', v: 180e3, p: 7.3, w: 15 },
      { n: 'Telegram', c: '#229ED9', v: 85e3, p: 3.3, w: 7 }
    ];
    const drawPlat = () => document.getElementById('sdPlat').innerHTML = plats.map(p => `
      <div class="sd-prow"><span class="nm">${p.n}</span>
        <span class="tr"><i style="width:${p.w}%;background:${p.c}"></i></span>
        <span class="vv">${fmt(p.v)} <span>(${p.p.toFixed(1)}%)</span></span></div>`).join('');
    drawPlat();

    const alerts = [
      { n: 'Communal Violence', k: 'sd-hi', l: 'High Risk', t: '2 min ago' },
      { n: 'Hate Speech', k: 'sd-hi', l: 'High Risk', t: '5 min ago' },
      { n: 'Fake News', k: 'sd-md', l: 'Medium Risk', t: '15 min ago' },
      { n: 'Protest Call', k: 'sd-md', l: 'Medium Risk', t: '30 min ago' }
    ];
    const drawAlerts = () => document.getElementById('sdAlerts').innerHTML = alerts.map(a => `
      <div class="sd-lrow"><span style="color:#E5372B">⚠</span><span class="nm">${a.n}</span>
        <span class="sd-chip ${a.k}">${a.l}</span><span class="ag">${a.t}</span></div>`).join('');
    drawAlerts();

    document.getElementById('sdGriev').innerHTML = [
      { n: 'Pothole on Main Street', id: '#GRV-12543', k: 'sd-nw', l: 'New', t: '10 min ago' },
      { n: 'Electricity Issue', id: '#GRV-12542', k: 'sd-ip', l: 'In Progress', t: '25 min ago' },
      { n: 'Water Supply Problem', id: '#GRV-12541', k: 'sd-lo', l: 'Resolved', t: '1 h ago' }
    ].map(g => `<div class="sd-lrow"><span style="color:#98A2B3">✉</span>
        <span class="nm">${g.n} <span style="color:#98A2B3;font-size:10px">${g.id}</span></span>
        <span class="sd-chip ${g.k}">${g.l}</span><span class="ag">${g.t}</span></div>`).join('');

    /* ── live feed ──────────────────────────────────── */
    const srcs = [
      { p: '𝕏', c: '#000', u: '@NewsUpdate' }, { p: 'f', c: '#1877F2', u: '@CityWatch' },
      { p: '◙', c: '#DD2A7B', u: '@ground_report' }, { p: '✈', c: '#229ED9', u: '@alert_channel' },
      { p: '▶', c: '#FF0000', u: '@LiveNews24' }
    ];
    const bodies = [
      ['Protest gathering at Connaught Place, New Delhi. Heavy police deployment in the area.', 'Protest', 'sd-hi', 'High Risk', 'Negative', '#E5372B'],
      ['Coordinated posting pattern detected across 40+ accounts on the fuel price thread.', 'Bot Network', 'sd-hi', 'High Risk', 'Negative', '#E5372B'],
      ['Municipal team resolved the water supply complaint in Ward 12 within 4 hours.', 'Grievance', 'sd-lo', 'Low Risk', 'Positive', '#12B76A'],
      ['Unverified claim about the new policy spreading in regional-language groups.', 'Fake News', 'sd-md', 'Medium Risk', 'Neutral', '#F79009'],
      ['Public appreciation trending for the new metro corridor announcement.', 'Sentiment', 'sd-lo', 'Low Risk', 'Positive', '#12B76A'],
      ['Local escalation reported near the district collectorate. Monitoring in progress.', 'Incident', 'sd-md', 'Medium Risk', 'Negative', '#E5372B']
    ];
    const feed = document.getElementById('sdFeed');
    let bi = 0;
    const push = () => {
      const s = srcs[Math.floor(Math.random() * srcs.length)], b = bodies[bi++ % bodies.length];
      const el = document.createElement('div');
      el.className = 'sd-fitem';
      el.innerHTML = `<div class="pv" style="background:${s.c}">${s.p}</div>
        <div class="bd"><div class="hd"><b>${s.u}</b><time>just now</time></div>
          <p>${b[0]}</p><div class="mt"><span class="sd-chip sd-nw">${b[1]}</span>
          <span class="sd-chip ${b[2]}">${b[3]}</span></div></div>
        <div class="rr"><span class="k">Reach</span><span class="v">${(rnd(4, 60)).toFixed(1)}K</span>
          <span class="k" style="margin-top:5px">Sentiment</span>
          <span class="v" style="color:${b[5]};font-size:11px">${b[4]}</span></div>`;
      feed.prepend(el);
      feed.querySelectorAll('.sd-fitem').forEach((n, i) => { if (i > 0) n.querySelector('time').textContent = i * 2 + ' min ago'; });
      while (feed.children.length > 2) feed.lastElementChild.remove();
    };
    push(); push();

    /* ── keep it alive ──────────────────────────────── */
    if (!RM) {
      /* stats drift */
      setInterval(() => {
        kpis.forEach((k, i) => {
          k.v *= 1 + rnd(-.004, .006);
          const el = document.querySelector(`[data-kv="${i}"]`);
          if (el) el.textContent = k.pct ? Math.min(99, k.v).toFixed(1) + '%' : fmt(k.v);
        });
        sent[0].p = Math.max(55, Math.min(70, sent[0].p + rnd(-.6, .6)));
        sent[2].p = Math.max(9, Math.min(20, sent[2].p + rnd(-.4, .4)));
        sent[1].p = 100 - sent[0].p - sent[2].p;
        legend(document.getElementById('sdSentLeg'), sent, kpis[0].v);
        document.getElementById('sdSentTotal').textContent = fmt(kpis[0].v);
        document.getElementById('sdRiskTotal').textContent = fmt(kpis[0].v);
        drawArcs();
      }, 3200);

      /* sparkline redraw */
      setInterval(() => document.querySelectorAll('[data-sp]').forEach(p =>
        p.setAttribute('points', spark(22, kpis[+p.dataset.sp].up))), 4600);

      /* platform bars breathe */
      setInterval(() => {
        plats.forEach(p => { p.w = Math.max(5, Math.min(100, p.w + rnd(-4, 4))); });
        drawPlat();
      }, 5200);

      /* new alert arrives */
      setInterval(() => {
        const pool = ['Coordinated Campaign', 'Deepfake Detected', 'Riot Instigation', 'Doxxing Attempt', 'Impersonation'];
        alerts.unshift({ n: pool[Math.floor(Math.random() * pool.length)], k: 'sd-hi', l: 'High Risk', t: 'just now' });
        alerts.length = 4;
        drawAlerts();
        const b = document.getElementById('sdAlertBadge'), c = document.getElementById('sdAlertCount'),
          bell = document.getElementById('sdBell');
        b.textContent = c.textContent = +b.textContent + 1;
        bell.textContent = +bell.textContent + 1;
      }, 7400);

      /* trending reshuffles */
      setInterval(() => {
        trend.forEach(t => { t.m = Math.max(20, t.m + Math.round(rnd(-8, 12))); t.c += rnd(-1.4, 1.4); });
        trend.sort((a, b) => b.m - a.m);
        drawTrend();
      }, 6100);

      /* feed keeps streaming */
      setInterval(push, 4200);
    }
  })();
</script>
<script>/* ═══════════════════════════════════════════════════════════
SAGA scene engine — one canvas, many scenes.
Hand-written projection so the mockup stays dependency-free.
In production these narrative scenes become baked WebP
sequences; only `hero` and `worlds` stay live.
═══════════════════════════════════════════════════════════ */
  (() => {
    const cv = document.getElementById('stage'), ctx = cv.getContext('2d', { alpha: true });
    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ORANGE = [241, 91, 38], LIFT = [255, 122, 69], GREY = [120, 116, 112];

    let W = 0, H = 0, DPR = 1;
    function resize() {
      DPR = Math.min(devicePixelRatio || 1, 2);
      W = innerWidth; H = innerHeight;
      cv.width = W * DPR; cv.height = H * DPR;
      cv.style.width = W + 'px'; cv.style.height = H + 'px';
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    resize(); addEventListener('resize', resize);

    /* ── point cloud ─────────────────────────────────────────── */
    const N = 820;
    const R = new Float32Array(N * 4);        // 4 stable randoms per point
    /* seeded PRNG — bakes must be reproducible, so no Math.random anywhere */
    let _s = 0x9E3779B9 >>> 0;
    const srnd = () => { _s ^= _s << 13; _s >>>= 0; _s ^= _s >> 17; _s ^= _s << 5; _s >>>= 0; return _s / 4294967296; };
    for (let i = 0; i < N; i++) { for (let k = 0; k < 4; k++) R[i * 4 + k] = srnd(); }

    const rnd = (i, k) => R[i * 4 + k];
    const lerp = (a, b, t) => a + (b - a) * t;
    const clamp = (v, a, b) => v < a ? a : v > b ? b : v;
    const easeInOut = t => t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

    /* ── projection ──────────────────────────────────────────── */
    let camRY = 0, camRX = 0, px = 0, py = 0;      // pointer parallax
    const FOV = 520;
    /* Where on screen the scene is anchored. Scenes set this so the 3D never
       sits underneath the copy column — the single biggest legibility win. */
    const O = { x: 0, y: 0 };
    let GS = 1;                            // per-scene global scale, set at scene start
    function anchorRight() { if (window.SAGA_BAKE) { O.x = W * 0.5; O.y = H * 0.5; return; } O.x = W > 1024 ? W * 0.705 : W * 0.5; O.y = H * 0.5; }
    function fit(base) { GS = base * clamp(Math.min(W, H) / 820, 0.62, 1.55); }
    function anchorCenter() { O.x = W * 0.5; O.y = H * 0.5; }
    function anchorEl(sel, fallbackRight) {
      const el = document.querySelector(sel);
      if (!el) { fallbackRight ? anchorRight() : anchorCenter(); return null; }
      const r = el.getBoundingClientRect();
      if (r.width < 40) { fallbackRight ? anchorRight() : anchorCenter(); return null; }
      O.x = r.left + r.width / 2; O.y = r.top + r.height / 2;
      return r;
    }
    function project(x, y, z, scale) {
      const cy = Math.cos(camRY), sy = Math.sin(camRY);
      let X = x * cy - z * sy, Z = x * sy + z * cy;
      const cx2 = Math.cos(camRX), sx2 = Math.sin(camRX);
      let Y = y * cx2 - Z * sx2; Z = y * sx2 + Z * cx2;
      const d = FOV / (FOV + Z + 340);
      const sc = scale * GS;
      return [O.x + X * d * sc + px, O.y + Y * d * sc + py, d];
    }
    function dot(x, y, z, scale, col, alpha, size) {
      const [sx, sy, d] = project(x, y, z, scale);
      if (d <= 0.05) return;
      const r = size * d, a = alpha * clamp(d * 1.15, 0, 1);
      if (a <= 0.01) return;
      ctx.fillStyle = `rgba(${col[0]},${col[1]},${col[2]},${a})`;
      ctx.beginPath(); ctx.arc(sx, sy, Math.max(.4, r), 0, 6.283); ctx.fill();
    }
    function line(a, b, scale, col, alpha, w) {
      const p1 = project(a[0], a[1], a[2], scale), p2 = project(b[0], b[1], b[2], scale);
      ctx.strokeStyle = `rgba(${col[0]},${col[1]},${col[2]},${alpha})`;
      ctx.lineWidth = w || 1;
      ctx.beginPath(); ctx.moveTo(p1[0], p1[1]); ctx.lineTo(p2[0], p2[1]); ctx.stroke();
    }
    function glow(x, y, rad, col, alpha) {
      const g = ctx.createRadialGradient(x, y, 0, x, y, rad);
      g.addColorStop(0, `rgba(${col[0]},${col[1]},${col[2]},${alpha})`);
      g.addColorStop(1, `rgba(${col[0]},${col[1]},${col[2]},0)`);
      ctx.fillStyle = g; ctx.fillRect(x - rad, y - rad, rad * 2, rad * 2);
    }

    /* ── world target clouds ─────────────────────────────────── */
    function buildWorld(kind) {
      const out = new Float32Array(N * 3);
      for (let i = 0; i < N; i++) {
        const a = rnd(i, 0), b = rnd(i, 1), c = rnd(i, 2), d = rnd(i, 3);
        let x, y, z;
        if (kind === 'police') {                                  // angular city grid
          const g = 7, gx = Math.round(a * g - g / 2), gz = Math.round(b * g - g / 2);
          const along = (c - .5) * 2;
          if (d < .5) { x = gx * 46; z = along * 160; } else { x = along * 160; z = gz * 46; }
          y = d < .14 ? -Math.abs(along) * 86 : (c - .5) * 10;
        } else if (kind === 'political') {                        // territorial patches
          const k = Math.floor(a * 6), ang = (k / 6) * 6.283;
          const cxx = Math.cos(ang) * 105, czz = Math.sin(ang) * 105;
          const rr = Math.sqrt(b) * 66, th = c * 6.283;
          x = cxx + Math.cos(th) * rr; z = czz + Math.sin(th) * rr; y = (d - .5) * 14 + Math.sin(rr * .05) * 8;
        } else if (kind === 'brand') {                            // radial spread
          const ring = Math.floor(a * 5) + 1, th = b * 6.283, spir = c * .9;
          const rr = ring * 34 + spir * 26;
          x = Math.cos(th + spir) * rr; z = Math.sin(th + spir) * rr; y = (d - .5) * 20 - ring * 4;
        } else {                                              // celebrity — organic clusters
          const k = Math.floor(a * 5), ang = (k / 5) * 6.283 + .6;
          const cxx = Math.cos(ang) * 96, cyy = (k % 2 ? -1 : 1) * 34, czz = Math.sin(ang) * 96;
          const rr = Math.pow(b, .7) * 54, th = c * 6.283, ph = Math.acos(2 * d - 1);
          x = cxx + Math.sin(ph) * Math.cos(th) * rr; y = cyy + Math.cos(ph) * rr * .7; z = czz + Math.sin(ph) * Math.sin(th) * rr;
        }
        out[i * 3] = x; out[i * 3 + 1] = y; out[i * 3 + 2] = z;
      }
      return out;
    }
    const CLOUD = {
      police: buildWorld('police'), political: buildWorld('political'),
      brand: buildWorld('brand'), celebrity: buildWorld('celebrity')
    };

    /* morph state */
    let wFrom = 'police', wTo = 'police', wT = 1, wStart = 0;
    const MORPH_MS = 900;

    /* ── scenes ──────────────────────────────────────────────── */
    const scenes = {

      /* 01 — live: signals converge into the core, then branch four ways */
      hero(p, t) {
        anchorRight(); fit(1.45);
        const fade = 1 - clamp((p - .55) / .45, 0, 1);
        if (fade <= 0) return;
        camRY = t * 0.00011; camRX = Math.sin(t * 0.00008) * 0.10;
        const [ccx, ccy] = project(0, 0, 0, 1);
        glow(ccx, ccy, Math.min(W, H) * 0.42, [122, 42, 14], 0.34 * fade);
        glow(ccx, ccy, 74, ORANGE, 0.28 * fade);

        for (let i = 0; i < N; i++) {
          const a = rnd(i, 0), b = rnd(i, 1), c = rnd(i, 2), d = rnd(i, 3);
          const ph = (t * 0.00013 + a) % 1;                     // travel 0→1 inward
          const th = b * 6.283, el = Math.acos(2 * c - 1);
          const far = 330 + d * 250, near = 16;
          const rr = lerp(far, near, ph * ph);
          const x = Math.sin(el) * Math.cos(th) * rr, y = Math.cos(el) * rr * .75, z = Math.sin(el) * Math.sin(th) * rr;
          const hot = ph > .72;
          const col = hot ? LIFT : (d > .55 ? ORANGE : GREY);
          dot(x, y, z, 1, col, (hot ? .95 : .42) * fade, hot ? 1.9 : 1.25);
        }
        /* four branches out of the core */
        for (let k = 0; k < 4; k++) {
          const ang = (k / 4) * 6.283 + t * 0.00011;
          const grow = clamp((Math.sin(t * 0.0006 - k * 1.2) + 1) / 2, 0, 1);
          for (let s = 0; s < 26; s++) {
            const f = s / 26, rr = 30 + f * 210 * grow;
            dot(Math.cos(ang) * rr, -f * 40, Math.sin(ang) * rr, 1, ORANGE, (1 - f) * .62 * fade, 1.5);
          }
        }
        ctx.fillStyle = `rgba(255,255,255,${.9 * fade})`;
        ctx.beginPath(); ctx.arc(ccx, ccy, 4.5, 0, 6.283); ctx.fill();
      },

      /* 02 — noise: everything is loud, three things matter */
      noise(p, t) {
        anchorRight(); fit(1.5);
        glow(O.x, O.y, Math.min(W, H) * 0.34, [122, 42, 14], 0.14);
        camRY = t * 0.00006; camRX = 0.06;
        const settle = easeInOut(clamp(p * 1.25, 0, 1));
        for (let i = 0; i < N; i++) {
          const a = rnd(i, 0), b = rnd(i, 1), c = rnd(i, 2), d = rnd(i, 3);
          const signal = d > 0.9905;                       // ~3 of 820
          const drift = Math.sin(t * 0.0004 + a * 9) * 8;
          const x = (a - .5) * 620, y = (b - .5) * 400 + drift, z = (c - .5) * 420;
          if (signal) {
            const rise = settle * -70;
            dot(x * .35, y * .4 + rise, z * .35, 1, LIFT, 1, lerp(1.6, 4.2, settle));
            const [sx, sy] = project(x * .35, y * .4 + rise, z * .35, 1);
            glow(sx, sy, lerp(0, 52, settle), ORANGE, .5 * settle);
          } else {
            dot(x, y, z, 1, GREY, lerp(.6, .08, settle), lerp(1.8, 1.1, settle));
          }
        }
      },

      /* 03 — observe: scattered sources organise into readable lanes */
      observe(p, t) {
        anchorRight(); fit(1.72);
        glow(O.x, O.y, Math.min(W, H) * 0.30, [122, 42, 14], 0.20);
        camRY = lerp(0.42, 0.10, easeInOut(p)) + t * 0.00004; camRX = lerp(0.05, 0.22, easeInOut(p));
        const o = easeInOut(clamp(p * 1.2, 0, 1));
        const LANES = 7;
        for (let i = 0; i < N; i++) {
          const a = rnd(i, 0), b = rnd(i, 1), c = rnd(i, 2), d = rnd(i, 3);
          const lane = Math.floor(a * LANES);
          const sx = (a - .5) * 640, sy = (b - .5) * 420, sz = (c - .5) * 440;
          const flow = ((t * 0.00016) + d) % 1;
          const tx = lerp(-250, 250, flow), ty = (lane - (LANES - 1) / 2) * 40, tz = (d - .5) * 36;
          const x = lerp(sx, tx, o), y = lerp(sy, ty, o), z = lerp(sz, tz, o);
          dot(x, y, z, 1, d > .72 ? ORANGE : GREY, lerp(.4, .95, o), lerp(1.5, 2.2, o));
        }
        /* lane rails appear as things organise */
        if (o > .35) {
          const al = (o - .35) / .65 * .16;
          for (let l = 0; l < LANES; l++) {
            const y = (l - (LANES - 1) / 2) * 40;
            line([-262, y, 0], [262, y, 0], 1, ORANGE, al * 1.6, 1);
          }
        }
      },

      /* 04 — understand: lanes classify, then connect into a network */
      understand(p, t) {
        anchorRight(); fit(1.62);
        glow(O.x, O.y, Math.min(W, H) * 0.30, [122, 42, 14], 0.22);
        camRY = 0.14 + easeInOut(p) * 0.42 + t * 0.00005; camRX = lerp(0.22, 0.30, p);
        const cls = easeInOut(clamp(p * 2, 0, 1));            // classify
        const net = easeInOut(clamp((p - .42) / .58, 0, 1));    // connect
        const LANES = 7;
        const pos = [];
        for (let i = 0; i < N; i++) {
          const a = rnd(i, 0), b = rnd(i, 1), c = rnd(i, 2), d = rnd(i, 3);
          const lane = Math.floor(a * LANES);
          const flow = ((t * 0.00016) + d) % 1;
          const lx = lerp(-250, 250, flow), ly = (lane - (LANES - 1) / 2) * 40, lz = (d - .5) * 36;
          /* network target: clustered by class */
          const grp = Math.floor(d * 4), ang = (grp / 4) * 6.283 + .4;
          const nx = Math.cos(ang) * 98 + (b - .5) * 70, ny = (c - .5) * 86, nz = Math.sin(ang) * 98 + (a - .5) * 70;
          const x = lerp(lx, nx, net), y = lerp(ly, ny, net), z = lerp(lz, nz, net);
          const risk = d > .86;
          const col = risk ? LIFT : (d > .55 ? ORANGE : GREY);
          dot(x, y, z, 1, col, lerp(.6, risk ? 1 : .85, cls), risk ? 3.0 : 1.9);
          if (i % 7 === 0) pos.push([x, y, z, d]);
        }
        if (net > .05) {
          for (let i = 0; i < pos.length; i++) {
            for (let j = i + 1; j < i + 3 && j < pos.length; j++) {
              const A = pos[i], B = pos[j];
              const dx = A[0] - B[0], dy = A[1] - B[1], dz = A[2] - B[2];
              if (dx * dx + dy * dy + dz * dz < 15000) line(A, B, 1, ORANGE, net * .22, 1);
            }
          }
        }
      },

      /* 05 — act: the network resolves into four owned stages */
      act(p, t) {
        anchorRight(); fit(1.7);
        glow(O.x, O.y, Math.min(W, H) * 0.30, [122, 42, 14], 0.20);
        camRY = lerp(0.95, 0.1, easeInOut(p)); camRX = lerp(0.3, 0.12, easeInOut(p));
        const f = easeInOut(clamp(p * 1.15, 0, 1));
        const STG = 4, ys = [-108, -36, 36, 108];
        for (let i = 0; i < N; i++) {
          const a = rnd(i, 0), b = rnd(i, 1), c = rnd(i, 2), d = rnd(i, 3);
          const grp = Math.floor(d * 4), ang = (grp / 4) * 6.283 + .4;
          const nx = Math.cos(ang) * 98 + (b - .5) * 70, ny = (c - .5) * 86, nz = Math.sin(ang) * 98 + (a - .5) * 70;
          const stg = Math.floor(a * STG);
          const bx = (b - .5) * 250, by = ys[stg] + (c - .5) * 13, bz = (d - .5) * 66;
          const x = lerp(nx, bx, f), y = lerp(ny, by, f), z = lerp(nz, bz, f);
          /* colour cools stage by stage — resolution reads as the orange draining out */
          const heat = 1 - stg / (STG - 1);
          const col = heat > .6 ? LIFT : heat > .3 ? ORANGE : [95, 208, 138];
          dot(x, y, z, 1, f > .5 ? col : ORANGE, lerp(.6, .95, f), 2.1);
        }
        if (f > .3) {
          const al = (f - .3) / .7;
          for (let s = 0; s < STG; s++) {
            const y = ys[s];
            line([-150, y, 0], [150, y, 0], 1, s === STG - 1 ? [95, 208, 138] : ORANGE, al * .22, 1);
          }
        }
      },

      /* 06 — live: the four worlds morph into each other */
      worlds(p, t) {
        const r = anchorEl('#worldslot', false);
        GS = clamp((r ? r.width : W) / 620, .55, 1.25);
        if (r) { ctx.save(); ctx.beginPath(); ctx.rect(r.left, r.top, r.width, r.height); ctx.clip(); }
        camRY = t * 0.00013; camRX = 0.30 + Math.sin(t * 0.0002) * 0.05;
        if (wT < 1) { wT = clamp((t - wStart) / MORPH_MS, 0, 1); }
        const m = easeInOut(wT);
        const A = CLOUD[wFrom], B = CLOUD[wTo];
        const SC = 1.0;
        const [ccx, ccy] = project(0, 0, 0, SC);
        glow(ccx, ccy, 210, [122, 42, 14], 0.42);
        const kind = m > .5 ? wTo : wFrom;
        for (let i = 0; i < N; i++) {
          const j = i * 3;
          const x = lerp(A[j], B[j], m), y = lerp(A[j + 1], B[j + 1], m), z = lerp(A[j + 2], B[j + 2], m);
          const d = rnd(i, 3);
          /* mid-morph everything cools to grey, then re-lights — reads as a system reconfiguring */
          const heat = Math.abs(m - .5) * 2;
          const col = d > .82 ? LIFT : d > .5 ? ORANGE : GREY;
          const mixed = [lerp(GREY[0], col[0], heat), lerp(GREY[1], col[1], heat), lerp(GREY[2], col[2], heat)];
          dot(x, y, z, SC, mixed, d > .82 ? 1 : .7, d > .82 ? 2.8 : 1.7);
        }
        /* per-world connective tissue */
        ctx.lineWidth = 1;
        if (kind === 'celebrity' || kind === 'brand') {
          for (let i = 0; i < N; i += 17) {
            const j = i * 3;
            const x = lerp(A[j], B[j], m), y = lerp(A[j + 1], B[j + 1], m), z = lerp(A[j + 2], B[j + 2], m);
            line([0, 0, 0], [x, y, z], SC, ORANGE, .10, 1);
          }
        }
        if (r) ctx.restore();
      },

      /* 07 — capability nodes orbiting the core */
      orbit(p, t) {
        anchorRight(); fit(1.35);
        camRY = t * 0.00009; camRX = 0.34;
        const [ccx, ccy] = project(0, 0, 0, 1);
        glow(ccx, ccy, Math.min(W, H) * 0.30, [122, 42, 14], 0.22);
        for (let i = 0; i < N; i++) {
          const a = rnd(i, 0), b = rnd(i, 1), c = rnd(i, 2), d = rnd(i, 3);
          const ring = Math.floor(a * 3) + 1, th = b * 6.283 + t * (0.00007 + ring * 0.00002);
          const rr = ring * 62 + (c - .5) * 22;
          dot(Math.cos(th) * rr, (d - .5) * 30, Math.sin(th) * rr, 1, d > .8 ? ORANGE : GREY, d > .8 ? .75 : .3, d > .8 ? 1.9 : 1.15);
        }
        for (let k = 0; k < 7; k++) {
          const th = (k / 7) * 6.283 + t * 0.00007;
          const rr = 186;
          dot(Math.cos(th) * rr, 0, Math.sin(th) * rr, 1, LIFT, .95, 3.4);
          line([0, 0, 0], [Math.cos(th) * rr, 0, Math.sin(th) * rr], 1, ORANGE, .10, 1);
        }
        ctx.fillStyle = 'rgba(255,255,255,.85)';
        ctx.beginPath(); ctx.arc(ccx, ccy, 4, 0, 6.283); ctx.fill();
      }
    };

    /* ── scene selection from scroll ─────────────────────────── */
    const hosts = [...document.querySelectorAll('[data-scene]')].map(el => ({ el, name: el.dataset.scene }));
    function activeScene() {
      const mid = H * 0.5; let best = null, bestD = Infinity;
      for (const h of hosts) {
        const r = h.el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > H) continue;
        const range = r.height - H;
        const p = range > 4 ? clamp(-r.top / range, 0, 1) : clamp((H * 0.75 - r.top) / (r.height || 1), 0, 1);
        const d = Math.abs((r.top + r.height / 2) - mid);
        if (d < bestD) { bestD = d; best = { name: h.name, p }; }
      }
      return best;
    }

    /* pointer parallax — hero only, and gently */
    let mx = 0, my = 0;
    if (!REDUCED) addEventListener('pointermove', e => { mx = (e.clientX / W - .5); my = (e.clientY / H - .5); }, { passive: true });

    /* ── loop ────────────────────────────────────────────────── */
    let last = 0, fps = 60, frames = 0, acc = 0, quality = 1;
    function frame(t) {
      const cur = activeScene();
      ctx.clearRect(0, 0, W, H);
      if (cur && scenes[cur.name]) {
        const heroish = cur.name === 'hero';
        px = lerp(px, mx * (heroish ? 34 : 10), .06);
        py = lerp(py, my * (heroish ? 24 : 8), .06);
        ctx.globalCompositeOperation = 'lighter';
        scenes[cur.name](cur.p, REDUCED ? 0 : t);
        ctx.globalCompositeOperation = 'source-over';
      }
      if (REDUCED) return;                       // one static frame, then stop
      /* auto-degrade: drop DPR if we can't hold frame budget */
      if (last) {
        acc += t - last; frames++;
        if (acc > 1200) {
          fps = frames * 1000 / acc; frames = 0; acc = 0;
          if (fps < 42 && quality === 1) { quality = .7; DPR = 1; resize(); }
        }
      }
      last = t;
      requestAnimationFrame(frame);
    }
    if (!window.SAGA_NO_LOOP) requestAnimationFrame(frame);

    /* ── public API for the tab system ───────────────────────── */
    window.SAGA_RENDER = function (name, p, t) {
      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'lighter';
      px = 0; py = 0;
      scenes[name](p, t);
      ctx.globalCompositeOperation = 'source-over';
    };
    window.SAGA_SETWORLD = function (k) { wFrom = k; wTo = k; wT = 1; };
    window.SCENE = {
      morph(k) {
        if (k === wTo) return;
        wFrom = wT < 1 ? wFrom : wTo;   // if mid-morph, keep origin so it never snaps
        wTo = k; wT = REDUCED ? 1 : 0; wStart = performance.now();
      }
    };
  })();
</script>

<!-- Native Smooth Anchor Scroll -->
<script>
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      const targetId = this.getAttribute('href');
      if (targetId && targetId !== '#') {
        const targetEl = document.querySelector(targetId);
        if (targetEl) {
          e.preventDefault();
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>