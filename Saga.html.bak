          { u: 'Amaragiri', t: '9 days', r: '', x: 'Water supply — negative sentiment up 18 points, spreading to three adjacent constituencies.', tags: ['High risk', 'Public complaint', 'Spreading'] },
          { u: 'Sirivenna North', t: '4 days', r: 'med', x: 'Road &amp; infrastructure complaints clustering around two ward boundaries.', tags: ['Medium', 'Infrastructure'] },
          { u: 'Kothanagar', t: '2 days', r: 'low', x: 'Positive movement following the health camp announcement. Sentiment recovering.', tags: ['Recovering', 'Government praise'] }],
        panelTitle: 'Issues by volume', panelTag: 'last 30 days',
        bars: [['Public complaint', 88], ['Political criticism', 71], ['Corruption complaint', 44], ['Law &amp; order', 31], ['Road &amp; infrastructure', 26]]
      }
    },
    brand: {
